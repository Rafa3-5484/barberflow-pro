generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum UserRole {
  OWNER
  ADMIN
  TECHNICIAN
  ATTENDANT
  VIEWER
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentType {
  SERVICE
  EVALUATION
  MAINTENANCE
  URGENT
  OTHER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum BudgetStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum FinancialType {
  REVENUE
  EXPENSE
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  PIX
  TRANSFER
  BOLETO
  OTHER
}

enum FinancialStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum CRMActivityType {
  CALL
  EMAIL
  WHATSAPP
  MEETING
  VISIT
  NOTE
  SYSTEM
}

enum AutomationTrigger {
  APPOINTMENT_CONFIRMED
  APPOINTMENT_COMPLETED
  APPOINTMENT_CANCELLED
  BUDGET_SENT
  BUDGET_ACCEPTED
  BUDGET_REJECTED
  CLIENT_CREATED
  REVIEW_RECEIVED
  SCHEDULED_TIME
  FOLLOW_UP
}

enum TeamMemberRole {
  TECHNICIAN
  ATTENDANT
  ADMIN
}

enum WhatsAppStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED
}

model Company {
  id        String      @id @default(cuid())
  name      String
  slug      String      @unique
  logo      String?
  document  String?
  phone     String?
  plan      CompanyPlan @default(STARTER)
  settings  Json?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  users           User[]
  clients         Client[]
  appointments    Appointment[]
  budgets         Budget[]
  financial       FinancialRecord[]
  routes          Route[]
  crmActivities   CRMActivity[]
  portfolioItems  PortfolioItem[]
  reviews         Review[]
  automations     Automation[]
  teamMembers     TeamMember[]
  notifications   Notification[]
  whatsappMessages WhatsAppMessage[]
  auditLogs       AuditLog[]
  companySettings CompanySettings?

  @@map("empresas")
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  password         String
  name             String
  phone            String?
  avatar           String?
  role             UserRole  @default(ATTENDANT)
  companyId        String
  company          Company   @relation(fields: [companyId], references: [id])
  active           Boolean   @default(true)
  emailVerified    Boolean   @default(false)
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String?
  refreshToken     String?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  appointments  Appointment[]
  budgets       Budget[]
  routes        Route[]
  teamMembers   TeamMember[]
  notifications Notification[]
  auditLogs     AuditLog[]
  crmActivities CRMActivity[]

  @@index([companyId])
  @@map("usuarios")
}

model Client {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  phone       String?
  email       String?
  document    String?
  address     Json?
  birthDate   DateTime?
  notes       String?
  source      String?
  tags        String[]
  totalSpent  Float    @default(0)
  totalVisits Int      @default(0)
  lastVisit   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointments  Appointment[]
  budgets       Budget[]
  financial     FinancialRecord[]
  crmActivities CRMActivity[]
  reviews       Review[]

  @@index([companyId])
  @@index([name])
  @@index([phone])
  @@index([email])
  @@map("clientes")
}

model Appointment {
  id                String            @id @default(cuid())
  companyId         String
  company           Company           @relation(fields: [companyId], references: [id])
  clientId          String
  client            Client            @relation(fields: [clientId], references: [id])
  userId            String
  user              User              @relation(fields: [userId], references: [id])
  title             String
  description       String?
  status            AppointmentStatus @default(SCHEDULED)
  type              AppointmentType   @default(SERVICE)
  priority          Priority          @default(MEDIUM)
  date              DateTime
  startTime         String
  endTime           String
  estimatedDuration Int?
  address           Json?
  photos            String[]
  attachments       String[]
  notes             String?
  price             Float?
  appointmentNumber Int                @default(autoincrement())
  recurrence        Json?
  confirmedAt       DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  routeAppointments RouteAppointment[]
  reviews           Review[]
  budgets           Budget[]
  financial         FinancialRecord[]

  @@index([companyId])
  @@index([clientId])
  @@index([userId])
  @@index([date])
  @@index([status])
  @@map("agendamentos")
}

model Budget {
  id             String       @id @default(cuid())
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id])
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  appointmentId  String?
  appointment    Appointment? @relation(fields: [appointmentId], references: [id])
  number         Int
  status         BudgetStatus @default(DRAFT)
  items          Json
  subtotal       Float
  discount       Float?
  discountType   DiscountType?
  shipping       Float?
  total          Float
  notes          String?
  conditions     String?
  warranty       String?
  validity       DateTime
  paymentMethods String[]
  pixCode        String?
  pixQrCode      String?
  signatureUrl   String?
  acceptedAt     DateTime?
  acceptedIp     String?
  acceptedLat    Float?
  acceptedLng    Float?
  sentAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  financial FinancialRecord[]

  @@index([companyId])
  @@index([clientId])
  @@index([userId])
  @@index([status])
  @@map("orcamentos")
}

model FinancialRecord {
  id                String          @id @default(cuid())
  companyId         String
  company           Company         @relation(fields: [companyId], references: [id])
  clientId          String?
  client            Client?         @relation(fields: [clientId], references: [id])
  appointmentId     String?
  appointment       Appointment?    @relation(fields: [appointmentId], references: [id])
  budgetId          String?
  budget            Budget?         @relation(fields: [budgetId], references: [id])
  type              FinancialType
  category          String
  description       String
  value             Float
  paymentMethod     PaymentMethod
  status            FinancialStatus @default(PENDING)
  dueDate           DateTime
  paidAt            DateTime?
  installment       Int?
  totalInstallments Int?
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([companyId])
  @@index([clientId])
  @@index([type])
  @@index([status])
  @@index([dueDate])
  @@map("financeiro")
}

model Route {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  date          DateTime
  appointments  Json?
  totalDistance Float    @default(0)
  totalDuration Int      @default(0)
  fuelCost      Float    @default(0)
  optimized     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  routeAppointments RouteAppointment[]

  @@index([companyId])
  @@index([userId])
  @@index([date])
  @@map("rotas")
}

model RouteAppointment {
  id                   String      @id @default(cuid())
  routeId              String
  route                Route       @relation(fields: [routeId], references: [id], onDelete: Cascade)
  appointmentId        String
  appointment          Appointment @relation(fields: [appointmentId], references: [id])
  order                Int
  estimatedArrival     String?
  distanceFromPrevious Float?
  durationFromPrevious Int?

  @@index([routeId])
  @@index([appointmentId])
  @@map("rotas_agendamentos")
}

model CRMActivity {
  id          String          @id @default(cuid())
  companyId   String
  company     Company         @relation(fields: [companyId], references: [id])
  clientId    String
  client      Client          @relation(fields: [clientId], references: [id])
  userId      String?
  user        User?           @relation(fields: [userId], references: [id])
  type        CRMActivityType
  description String
  metadata    Json?
  createdAt   DateTime        @default(now())

  @@index([companyId])
  @@index([clientId])
  @@index([userId])
  @@map("atividades_crm")
}

model PortfolioItem {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  title       String
  description String?
  category    String?
  beforePhoto String?
  afterPhoto  String?
  photos      String[]
  city        String?
  duration    String?
  clientName  String?
  rating      Float?
  tags        String[]
  public      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@map("portifolio")
}

model Review {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id])
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  rating        Int
  comment       String?
  photos        String[]
  public        Boolean  @default(true)
  responded     Boolean  @default(false)
  response      String?
  respondedAt   DateTime?
  createdAt     DateTime @default(now())

  @@index([companyId])
  @@index([clientId])
  @@index([appointmentId])
  @@map("avaliacoes")
}

model Automation {
  id        String            @id @default(cuid())
  companyId String
  company   Company           @relation(fields: [companyId], references: [id])
  name      String
  trigger   AutomationTrigger
  actions   Json
  active    Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([companyId])
  @@map("automacoes")
}

model TeamMember {
  id          String          @id @default(cuid())
  companyId   String
  company     Company         @relation(fields: [companyId], references: [id])
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  role        TeamMemberRole
  permissions String[]
  commission  Float?
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
  @@map("equipe")
}

model Notification {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  title     String
  message   String
  data      Json?
  read      Boolean  @default(false)
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([userId])
  @@map("notificacoes")
}

model WhatsAppMessage {
  id          String         @id @default(cuid())
  companyId   String
  company     Company        @relation(fields: [companyId], references: [id])
  from        String
  to          String
  body        String
  mediaUrl    String?
  messageType String
  status      WhatsAppStatus @default(PENDING)
  externalId  String?
  metadata    Json?
  createdAt   DateTime       @default(now())

  @@index([companyId])
  @@index([status])
  @@map("mensagens_whatsapp")
}

model AuditLog {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([userId])
  @@index([entity])
  @@map("auditoria")
}

model CompanySettings {
  id                    String  @id @default(cuid())
  companyId             String  @unique
  company               Company @relation(fields: [companyId], references: [id])
  workingHours          Json?
  weekStart             String  @default("monday")
  appointmentDuration   Int     @default(60)
  autoConfirmation      Boolean @default(true)
  reminderEnabled       Boolean @default(true)
  defaultBudgetValidity Int     @default(7)
  pixKey                String?
  pixKeyType            String?
  bankInfo              Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("configuracoes_empresa")
}
