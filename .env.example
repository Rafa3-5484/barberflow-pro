# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/serviceflow?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-jwt-secret-change-in-production"
JWT_EXPIRES_IN="7d"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Stripe
STRIPE_SECRET_KEY="your-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="your-webhook-secret"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="your-publishable-key"

# Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN="your-access-token"
MERCADO_PAGO_PUBLIC_KEY="your-public-key"

# Cloudflare R2
R2_ACCESS_KEY_ID="your-access-key"
R2_SECRET_ACCESS_KEY="your-secret-key"
R2_BUCKET_NAME="serviceflow-uploads"
R2_ENDPOINT="https://your-account.r2.cloudflarestorage.com"
R2_PUBLIC_URL="https://pub-xxxx.r2.dev"

# OpenAI
OPENAI_API_KEY="your-openai-api-key"

# WhatsApp
WHATSAPP_API_KEY="your-whatsapp-api-key"
WHATSAPP_PHONE_NUMBER_ID="your-phone-id"
WHATSAPP_BUSINESS_ACCOUNT_ID="your-business-account-id"
EVOLUTION_API_URL="https://evolution-api.your-server.com"
EVOLUTION_API_KEY="your-evolution-api-key"

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-maps-api-key"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# SMTP
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-pass"
SMTP_FROM="noreply@serviceflow.ai"

# Firebase
FIREBASE_SERVER_KEY="your-firebase-server-key"
FIREBASE_PROJECT_ID="your-project-id"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
API_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:3001"
NODE_ENV="development"
