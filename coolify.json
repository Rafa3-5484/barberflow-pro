{
  "name": "ServiceFlow AI",
  "type": "docker-compose",
  "description": "Platform for service providers - automation, scheduling, financial management",
  "services": {
    "postgres": {
      "type": "postgresql",
      "version": "16",
      "configuration": {
        "POSTGRES_USER": "${POSTGRES_USER}",
        "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD}",
        "POSTGRES_DB": "${POSTGRES_DB}"
      }
    },
    "redis": {
      "type": "redis",
      "version": "7"
    },
    "api": {
      "type": "dockerfile",
      "context": "./apps/api",
      "build": {
        "dockerfile": "Dockerfile"
      },
      "environment": {
        "NODE_ENV": "production",
        "DATABASE_URL": "${DATABASE_URL}",
        "REDIS_URL": "${REDIS_URL}",
        "JWT_SECRET": "${JWT_SECRET}",
        "CORS_ORIGIN": "${NEXT_PUBLIC_APP_URL}"
      }
    },
    "web": {
      "type": "dockerfile",
      "context": "./apps/web",
      "build": {
        "dockerfile": "Dockerfile"
      },
      "environment": {
        "NODE_ENV": "production",
        "NEXT_PUBLIC_API_URL": "${NEXT_PUBLIC_API_URL}",
        "NEXT_PUBLIC_APP_URL": "${NEXT_PUBLIC_APP_URL}"
      }
    }
  }
}
